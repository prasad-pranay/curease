# Backend
/curease backend/node_modules/
/curease backend/__pycache__/
# remove recipts
/curease backend/recipts/*
!/curease backend/recipts/.gitkeep
# remove for public folders
/curease backend/public/DoctorProfileImage/*
!/curease backend/public/DoctorProfileImage/.gitkeep
